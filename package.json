{
  "name": "erp-backend",
  "version": "0.1.0",
  "description": "Enterprise modular-monolith backend: NestJS, Clean Architecture, CQRS, Drizzle, Zod",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "test": "vitest run --project unit --project architecture",
    "test:unit": "vitest run --project unit",
    "test:arch": "vitest run --project architecture",
    "test:int": "vitest run --project integration",
    "test:e2e": "vitest run --project e2e",
    "test:all": "npm test && npm run test:int && npm run test:e2e",
    "test:cov": "vitest run --project unit --project architecture --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/cli/migrate.ts",
    "db:migrate:prod": "node dist/cli/migrate.js",
    "db:seed:dev": "nest build && node dist/cli/seed-dev.js",
    "admin:bootstrap": "node dist/cli/bootstrap-admin.js",
    "audit:deps": "npm audit --omit=dev",
    "etl": "nest build && node dist/cli/etl.js",
    "etl:prod": "node dist/cli/etl.js"
  },
  "dependencies": {
    "@nestjs/common": "^12.2.0",
    "@nestjs/core": "^12.2.0",
    "@nestjs/cqrs": "^12.1.1",
    "@nestjs/platform-express": "^12.2.0",
    "@nestjs/swagger": "^12.0.4",
    "@nestjs/throttler": "^6.7.1",
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "drizzle-orm": "^0.45.4",
    "exceljs": "4.4.0",
    "handlebars": "4.7.10",
    "helmet": "^8.3.0",
    "jose": "^6.2.13",
    "mssql": "^12.7.13",
    "nestjs-pino": "^5.3.1",
    "nodemailer": "^10.2.1",
    "pdfmake": "0.3.11",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "playwright": "1.64.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "overrides": {
    "multer": "^2.5.0",
    "uuid": "11.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.10",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.2.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/mssql": "^12.3.0",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfmake": "0.3.3",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.5",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.5",
    "dotenv": "^18.0.9",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
