{{#with data}}
<table class="report" style="margin-bottom: 10px">
  <tbody>
    <tr><td style="width: 18%">Admission</td><td><b>{{admission.number}}</b></td><td style="width: 18%">UHID</td><td>{{admission.uhid}}</td></tr>
    <tr><td>Patient</td><td>{{admission.patientName}}</td><td>Admitted on</td><td>{{date admission.admittedOn}}</td></tr>
  </tbody>
</table>
<table class="report">
  <thead>
    <tr>
      <th>Date</th><th>Document</th><th>Entry</th><th>Outlet</th><th>Medicine</th>
      <th class="num">Qty</th><th class="num">Rate</th><th class="num">Charged</th>
    </tr>
  </thead>
  <tbody>
    {{#each lines}}
    <tr>
      <td>{{date on}}</td><td>{{number}}</td><td>{{kindLabel}}</td><td>{{outletName}}</td><td>{{productName}}</td>
      <td class="num">{{qty}}</td><td class="num">{{money saleRate}}</td><td class="num">{{money total}}</td>
    </tr>
    {{else}}
    <tr><td colspan="8" class="empty">No medicine was sent to the ward.</td></tr>
    {{/each}}
  </tbody>
</table>
<table class="report" style="margin-top: 10px; width: 40%; margin-left: auto">
  <tbody>
    <tr><td>Sent to the ward</td><td class="num">{{money issued}}</td></tr>
    <tr><td>Sent back</td><td class="num">{{#if returned}}−{{/if}}{{money returned}}</td></tr>
    <tr><td><b>Charged to the stay</b></td><td class="num"><b>{{money net}}</b></td></tr>
  </tbody>
</table>
{{/with}}
