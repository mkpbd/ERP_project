<style>
  /* An 80 mm roll: 70 mm of print inside the 5 mm margins. */
  .receipt { width: 70mm; font-size: 8pt; line-height: 1.3; }
  .receipt .head { text-align: center; margin-bottom: 1.5mm; }
  .receipt .head .org { font-weight: 700; font-size: 10pt; }
  .receipt .bars { width: 60mm; height: 9mm; margin: 1mm auto 0; }
  .receipt .bars svg { width: 100%; height: 100%; display: block; }
  .receipt .rule { border-top: 0.2mm dashed #000; margin: 1.5mm 0; }
  .receipt table { width: 100%; border-collapse: collapse; font-size: 8pt; }
  .receipt td { padding: 0.4mm 0; vertical-align: top; }
  .receipt .num { text-align: right; white-space: nowrap; }
  .receipt .small { font-size: 6.5pt; color: #333; }
  .receipt .total td { font-weight: 700; font-size: 10pt; }
</style>
{{#with data}}
<div class="receipt">
  <div class="head">
    <div class="org">{{organization.organizationName}}</div>
    <div class="small">{{organization.address}}{{#if organization.hotline}} · {{organization.hotline}}{{/if}}</div>
    <div>{{receipt.kindLabel}} · {{receipt.number}}</div>
    <div class="bars">{{{barcode}}}</div>
  </div>
  <div class="rule"></div>
  <table>
    <tr><td>Date</td><td>{{datetime receipt.createdAt}}</td></tr>
    <tr><td>Admission</td><td>{{receipt.admissionNumber}}</td></tr>
    {{#if receipt.billNumber}}<tr><td>Final bill</td><td>{{receipt.billNumber}}</td></tr>{{/if}}
    <tr><td>UHID</td><td>{{receipt.uhidLabel}}</td></tr>
    <tr><td>Patient</td><td>{{receipt.patientName}}</td></tr>
    <tr><td>Method</td><td>{{receipt.methodLabel}}{{#if receipt.reference}} ({{receipt.reference}}){{/if}}</td></tr>
  </table>
  <div class="rule"></div>
  <table>
    <tr class="total"><td>{{#if (eq receipt.kind "refund")}}Paid back{{else}}Received{{/if}}</td><td class="num">{{money receipt.amount}}</td></tr>
  </table>
  <div class="small">{{amountInWords receipt.amount}}</div>
  <div class="rule"></div>
  <div class="small" style="text-align: center">{{#if receipt.receivedByName}}By {{receipt.receivedByName}}{{/if}}</div>
</div>
{{/with}}
