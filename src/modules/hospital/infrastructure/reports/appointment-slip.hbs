<style>
  /* An 80 mm roll: 70 mm of print inside the 5 mm margins. */
  .slip { width: 70mm; font-size: 8.5pt; line-height: 1.35; }
  .slip .head { text-align: center; margin-bottom: 2mm; }
  .slip .head .org { font-weight: 700; font-size: 10pt; }
  .slip .rule { border-top: 0.2mm dashed #000; margin: 1.5mm 0; }
  .slip .serial { text-align: center; font-size: 22pt; font-weight: 800; line-height: 1.1; }
  .slip .time { text-align: center; font-size: 11pt; font-weight: 700; }
  .slip table { width: 100%; border-collapse: collapse; }
  .slip td { padding: 0.4mm 0; vertical-align: top; }
  .slip td:first-child { width: 22mm; color: #333; }
</style>
{{#with data}}
<div class="slip">
  <div class="head">
    <div class="org">{{organization}}</div>
    <div>Appointment</div>
  </div>
  <div class="rule"></div>
  <div><b>{{appointment.doctorName}}</b>{{#if appointment.roomNo}} · Room {{appointment.roomNo}}{{/if}}</div>
  <div>{{date appointment.appointmentDate}}</div>
  <div class="serial">Serial {{appointment.serial}}</div>
  <div class="time">about {{appointment.slotTime}}</div>
  <div class="rule"></div>
  <table>
    <tr><td>Patient</td><td>{{appointment.patientName}}</td></tr>
    {{#if appointment.uhidLabel}}<tr><td>UHID</td><td>{{appointment.uhidLabel}}</td></tr>{{/if}}
    <tr><td>Mobile</td><td>{{appointment.mobileNo}}</td></tr>
    <tr><td>Visit</td><td>{{appointment.visit}}</td></tr>
    <tr><td>Fee</td><td>{{money appointment.fee}} (paid at the counter)</td></tr>
    {{#if appointment.referredByName}}<tr><td>Referred by</td><td>{{appointment.referredByName}}</td></tr>{{/if}}
  </table>
  <div class="rule"></div>
  <div style="text-align: center; font-size: 7pt">Please come 15 minutes before your time.{{#if (eq appointment.status "cancelled")}} <b>CANCELLED</b>{{/if}}</div>
</div>
{{/with}}
