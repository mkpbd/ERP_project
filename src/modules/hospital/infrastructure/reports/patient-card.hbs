<style>
  /* One CR80 card (85.6 × 54 mm), 5 mm margins from the bare layout. */
  .card { height: 43mm; display: flex; flex-direction: column; overflow: hidden; font-size: 7.5pt; line-height: 1.25; }
  .card .head { display: flex; align-items: center; gap: 2mm; border-bottom: 0.3mm solid #000; padding-bottom: 1mm; }
  .card .head img { height: 7mm; }
  .card .org { font-weight: 800; font-size: 8.5pt; }
  .card .what { font-size: 6.5pt; letter-spacing: 0.4pt; text-transform: uppercase; }
  .card .body { display: flex; gap: 2mm; margin-top: 1.2mm; flex: 1; }
  .card .photo { width: 15mm; height: 18mm; border: 0.2mm solid #888; object-fit: cover; }
  .card .name { font-weight: 800; font-size: 9pt; }
  .card .bars { width: 52mm; height: 7mm; margin-top: 0.8mm; }
  .card .bars svg { width: 100%; height: 100%; display: block; }
  .card .uhid { font-weight: 800; font-size: 9pt; letter-spacing: 0.6pt; }
  .card .alert { color: #b00; font-weight: 700; }
</style>
{{#with data}}
<div class="card">
  <div class="head">
    {{#if organization.logoDataUri}}<img src="{{organization.logoDataUri}}" alt="" />{{/if}}
    <div>
      <div class="org">{{organization.organizationName}}</div>
      <div class="what">Patient identification card</div>
    </div>
  </div>
  <div class="body">
    {{#if photo}}<img class="photo" src="{{photo}}" alt="" />{{/if}}
    <div>
      <div class="name">{{#if patient.title}}{{patient.title}} {{/if}}{{patient.fullName}}</div>
      <div>{{patient.sex}} · {{patient.age}}{{#if patient.bloodGroup}} · Blood {{patient.bloodGroup}}{{/if}}</div>
      <div>Born {{date patient.dateOfBirth}}{{#if patient.birthEstimated}} (est.){{/if}} · {{patient.mobileNo}}</div>
      {{#if patient.specialAlert}}<div class="alert">{{patient.specialAlert}}</div>{{/if}}
      <div class="bars">{{{barcode}}}</div>
      <div class="uhid">UHID {{patient.uhid}}</div>
    </div>
  </div>
  <div class="what">Issued {{date issuedOn}} · bring this card to every visit</div>
</div>
{{/with}}
