<style>
  /* One CR80 card (85.6 × 54 mm), 5 mm margins from the bare layout. */
  .pass { height: 43mm; display: flex; flex-direction: column; overflow: hidden; font-size: 7.5pt; line-height: 1.3; }
  .pass .head { display: flex; align-items: center; gap: 2mm; border-bottom: 0.3mm solid #000; padding-bottom: 1mm; }
  .pass .head img { height: 7mm; }
  .pass .org { font-weight: 800; font-size: 8.5pt; }
  .pass .what { font-size: 6.5pt; letter-spacing: 0.4pt; text-transform: uppercase; }
  .pass .kind { margin-left: auto; font-weight: 800; font-size: 9pt; border: 0.3mm solid #000; padding: 0.3mm 1.5mm; }
  .pass .visitor { font-weight: 800; font-size: 9.5pt; margin-top: 1.2mm; }
  .pass .muted { color: #333; }
  .pass .bars { width: 52mm; height: 7mm; margin-top: 1mm; }
  .pass .bars svg { width: 100%; height: 100%; display: block; }
  .pass .number { font-weight: 800; letter-spacing: 0.6pt; }
  .pass .foot { margin-top: auto; font-size: 6.5pt; }
</style>
{{#with data}}
<div class="pass">
  <div class="head">
    {{#if organization.logoDataUri}}<img src="{{organization.logoDataUri}}" alt="" />{{/if}}
    <div>
      <div class="org">{{organization.organizationName}}</div>
      <div class="what">Visitor pass</div>
    </div>
    <div class="kind">VISITOR</div>
  </div>
  <div class="visitor">{{pass.visitorName}}{{#if pass.relation}} <span class="muted">({{pass.relation}})</span>{{/if}}</div>
  <div>For <b>{{pass.patientName}}</b> · UHID {{pass.uhidLabel}}</div>
  <div>{{#if pass.wardName}}{{pass.wardName}} · {{/if}}{{#if pass.bedCode}}Bed {{pass.bedCode}} · {{/if}}{{pass.admissionNumber}}</div>
  <div class="bars">{{{barcode}}}</div>
  <div class="number">{{pass.number}}</div>
  <div class="foot">Issued {{datetime pass.issuedAt}} · valid while the patient is admitted · return it at discharge</div>
</div>
{{/with}}
