{{#with data}}
<p><b>{{person.employeeNo}} — {{person.fullName}}</b>, {{person.designation}}, {{person.department}}</p>
<table class="report">
  <thead>
    <tr>
      <th style="width: 80px">Date</th><th>Particulars</th>
      <th class="num">{{creditLabel}}</th><th class="num">{{debitLabel}}</th><th class="num">Balance</th>
    </tr>
  </thead>
  <tbody>
    <tr class="group-row"><td colspan="4">Opening balance</td><td class="num">{{money statement.opening}}</td></tr>
    {{#each statement.rows}}
    <tr>
      <td>{{date date}}</td><td>{{description}}</td>
      <td class="num">{{#if credit}}{{money credit}}{{/if}}</td>
      <td class="num">{{#if debit}}{{money debit}}{{/if}}</td>
      <td class="num">{{money balance}}</td>
    </tr>
    {{/each}}
    <tr class="group-row"><td colspan="4">Closing balance</td><td class="num">{{money statement.closing}}</td></tr>
  </tbody>
</table>
{{/with}}
