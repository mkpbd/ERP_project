<style>
  .meta { display: grid; grid-template-columns: 1fr 1fr; gap: 2px 16px; margin: 6px 0 10px; }
  .meta b { display: inline-block; width: 90px; color: #444; font-weight: 600; }
  .draft { text-align: center; color: #b00020; font-weight: 700; }
  .signs { display: flex; justify-content: space-between; margin-top: 56px; }
  .signs div { border-top: 1px solid #222; width: 130px; text-align: center; padding-top: 2px; }
</style>
{{#with data}}
{{#if (eq status 'draft')}}<div class="draft">DRAFT — not posted</div>{{/if}}
{{#if (eq status 'reversed')}}<div class="draft">REVERSED</div>{{/if}}
<div class="meta">
  <div><b>Voucher no</b>{{#if number}}{{number}}{{else}}—{{/if}}</div>
  <div><b>Date</b>{{date voucherDate}}</div>
  <div><b>Journal</b>{{journalShortName}}</div>
  <div><b>Fiscal year</b>{{fiscalYearLabel}}</div>
  {{#if paidTo}}<div><b>Paid to</b>{{paidTo}}</div>{{/if}}
  {{#if mode}}<div><b>Mode</b>{{mode}}</div>{{/if}}
  {{#if narration}}<div style="grid-column: 1 / 3"><b>Narration</b>{{narration}}</div>{{/if}}
</div>
<table class="report">
  <thead>
    <tr><th style="width: 90px">Code</th><th>Account</th><th>Particulars</th><th class="num">Debit</th><th class="num">Credit</th></tr>
  </thead>
  <tbody>
    {{#each lines}}
    <tr>
      <td>{{glCode}}</td><td>{{glName}}</td>
      <td>{{narration}}{{#if chequeNo}}{{#if narration}} · {{/if}}Cheque {{chequeNo}}{{#if chequeDate}} of {{date chequeDate}}{{/if}}{{/if}}</td>
      <td class="num">{{#if debit}}{{money debit}}{{/if}}</td><td class="num">{{#if credit}}{{money credit}}{{/if}}</td>
    </tr>
    {{/each}}
    <tr class="group-row"><td colspan="3">Total</td><td class="num">{{money total}}</td><td class="num">{{money total}}</td></tr>
  </tbody>
</table>
<p>In words: {{amountInWords total}}</p>
<div class="signs"><div>Prepared by</div><div>Checked by</div><div>Approved by</div><div>Received by</div></div>
{{/with}}
