{{#if data.member}}
<table class="report">
  <thead>
    <tr>
      <th>Date</th><th>Shift</th><th>In</th><th>Out</th><th>Status</th>
      <th class="num">Late</th><th class="num">Early out</th><th class="num">Worked</th><th class="num">Overtime</th><th>Note</th>
    </tr>
  </thead>
  <tbody>
    {{#each data.rows}}
    <tr>
      <td>{{date date}}</td>
      <td>{{shift}}</td>
      <td>{{time inAt}}{{#if (eq source "manual")}} <span class="muted">(manual)</span>{{/if}}</td>
      <td>{{time outAt}}</td>
      <td>{{lookup @root.data.labels status}}</td>
      <td class="num">{{duration lateMinutes}}</td>
      <td class="num">{{duration earlyOutMinutes}}</td>
      <td class="num">{{duration workMinutes}}</td>
      <td class="num">{{duration overtimeMinutes}}</td>
      <td>{{note}}</td>
    </tr>
    {{/each}}
  </tbody>
</table>

<h3 style="font-size: 12px; margin: 12px 0 4px">Punches</h3>
{{#if data.punches.length}}
<table class="report">
  <thead><tr><th>#</th><th>Date and time</th><th class="num">Machine</th></tr></thead>
  <tbody>
    {{#each data.punches}}<tr><td class="center">{{inc @index}}</td><td>{{datetime punchedAt}}</td><td class="num">{{machineNo}}</td></tr>{{/each}}
  </tbody>
</table>
{{else}}<p class="muted">No punches in this period.</p>{{/if}}
{{else}}
<p class="empty">Staff record not found.</p>
{{/if}}
