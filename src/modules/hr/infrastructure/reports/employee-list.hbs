{{#if data.total}}
<table class="report">
  <thead>
    <tr>
      <th class="center" style="width: 28px">#</th>
      <th>Employee no</th>
      <th>Name</th>
      <th>Sub-department</th>
      <th>Designation</th>
      <th>Joining date</th>
      <th>Status</th>
      <th>Reason</th>
      <th>Separated on</th>
    </tr>
  </thead>
  <tbody>
    {{#each data.groups}}
    <tr class="group-row"><td colspan="9">{{department}} ({{rows.length}})</td></tr>
    {{#each rows}}
    <tr>
      <td class="center">{{inc @index}}</td>
      <td>{{employeeNo}}</td>
      <td>{{fullName}}</td>
      <td>{{subDepartment}}</td>
      <td>{{designation}}</td>
      <td>{{date joiningDate}}</td>
      <td>{{#if (eq status "active")}}Active{{else if (eq status "inactive")}}Inactive{{else}}Separated{{/if}}</td>
      <td>{{statusReason}}</td>
      <td>{{date separationDate}}</td>
    </tr>
    {{/each}}
    {{/each}}
  </tbody>
</table>
<p class="muted">Total employees: {{data.total}}</p>
{{else}}
<p class="empty">No employees match these filters.</p>
{{/if}}
