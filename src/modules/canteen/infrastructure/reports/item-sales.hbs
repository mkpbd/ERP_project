{{#with data}}
{{#if rows.length}}
<table class="report">
  <thead><tr><th>Group</th><th>Item</th><th class="num">Quantity</th><th class="num">Amount</th><th class="num">VAT</th></tr></thead>
  <tbody>
    {{#each rows}}
    <tr><td>{{groupName}}</td><td>{{itemName}}</td><td class="num">{{qty}}</td><td class="num">{{money amount}}</td><td class="num">{{money vat}}</td></tr>
    {{/each}}
  </tbody>
  <tfoot><tr><th colspan="3">Total</th><th class="num">{{money totals.amount}}</th><th class="num">{{money totals.vat}}</th></tr></tfoot>
</table>
<p class="muted">Amounts before the sale discount. Cancelled sales are left out.</p>
{{else}}
<p>Nothing was sold in this period.</p>
{{/if}}
{{/with}}
