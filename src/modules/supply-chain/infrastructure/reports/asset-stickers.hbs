<style>
  /* Three stickers to a row on A4; the thin grey borders are the cutting lines. */
  .stickers { display: grid; grid-template-columns: repeat(3, 1fr); gap: 3mm; }
  .sticker { border: 0.2mm solid #999; padding: 2mm; text-align: center; break-inside: avoid; }
  .sticker .bars { height: 12mm; }
  .sticker .bars svg { width: 100%; height: 100%; display: block; }
  .sticker .no { font-weight: 700; font-size: 10pt; margin-top: 1mm; letter-spacing: 0.5pt; }
  .sticker .name { font-size: 7.5pt; line-height: 1.2; }
  .empty { text-align: center; padding: 40mm 0; color: #666; }
</style>
{{#if data.labels.length}}
<div class="stickers">
  {{#each data.labels}}
  <div class="sticker">
    <div class="bars">{{{barcode}}}</div>
    <div class="no">{{assetNo}}</div>
    <div class="name">{{itemName}} — {{variantName}}</div>
  </div>
  {{/each}}
</div>
{{else}}
<p class="empty">No fixed-asset pieces for this selection.</p>
{{/if}}
