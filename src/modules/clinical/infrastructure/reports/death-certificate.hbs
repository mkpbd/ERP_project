<style>
  .cert { font-size: 11pt; }
  .cert .head { text-align: center; border-bottom: 0.4mm solid #000; padding-bottom: 2mm; margin-bottom: 5mm; }
  .cert .head .org { font-size: 15pt; font-weight: 700; }
  .cert .head .kind { font-size: 13pt; font-weight: 700; margin-top: 2mm; letter-spacing: 1.5pt; }
  .cert table { width: 100%; border-collapse: collapse; margin-bottom: 5mm; }
  .cert td { padding: 1.5mm 2mm; vertical-align: top; border-bottom: 0.1mm dotted #888; }
  .cert td.label { width: 32%; color: #333; }
  .cert h3 { font-size: 11pt; margin: 4mm 0 1mm; }
  .cert .sign { margin-top: 25mm; display: flex; justify-content: flex-end; }
  .cert .sign div { text-align: center; min-width: 65mm; border-top: 0.2mm solid #000; padding-top: 1mm; }
</style>
{{#with data}}
<div class="cert">
  <div class="head">
    <div class="org">{{organization.organizationName}}</div>
    <div>{{organization.address}}{{#if organization.hotline}} · {{organization.hotline}}{{/if}}</div>
    <div class="kind">DEATH CERTIFICATE</div>
    <div>No. {{record.number}}</div>
  </div>
  <table>
    <tr><td class="label">Name of the deceased</td><td><b>{{patient.name}}</b></td></tr>
    <tr><td class="label">UHID · sex · age</td><td>{{patient.uhidLabel}} · {{patient.sex}} · {{patient.age}}</td></tr>
    {{#if record.deceasedNid}}<tr><td class="label">NID</td><td>{{record.deceasedNid}}</td></tr>{{/if}}
    <tr><td class="label">Admission</td><td>{{admission.number}}, admitted {{date admission.admittedOn}}</td></tr>
    <tr><td class="label">Date and time of death</td><td><b>{{datetime record.diedAt}}</b></td></tr>
  </table>
  <h3>Cause of death</h3>
  <table>
    <tr><td class="label">Immediate cause</td><td><b>{{record.cause}}</b></td></tr>
    {{#if record.antecedentCause}}<tr><td class="label">Due to</td><td>{{record.antecedentCause}}</td></tr>{{/if}}
    {{#if record.otherConditions}}<tr><td class="label">Other significant conditions</td><td>{{record.otherConditions}}</td></tr>{{/if}}
  </table>
  {{#if record.guardianName}}
  <h3>Guardian</h3>
  <table>
    <tr><td class="label">Name</td><td>{{record.guardianName}}{{#if record.guardianRelation}} ({{record.guardianRelation}}){{/if}}</td></tr>
    {{#if record.guardianNid}}<tr><td class="label">NID</td><td>{{record.guardianNid}}</td></tr>{{/if}}
    {{#if record.familyContactNo}}<tr><td class="label">Contact</td><td>{{record.familyContactNo}}</td></tr>{{/if}}
  </table>
  {{/if}}
  <div class="sign"><div>{{doctor.name}}{{#if doctor.degrees}}<br />{{doctor.degrees}}{{/if}}<br />Certifying doctor</div></div>
</div>
{{/with}}
