# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Set true only behind a trusted reverse proxy (affects client IP + rate limiting).
TRUST_PROXY=false

# --- Database --------------------------------------------------------------
# Application role should be least-privilege (DML only); run migrations with a separate owner role.
DATABASE_URL=postgres://erp_app:change-me@localhost:5432/erp_dev
DATABASE_POOL_MAX=10
# Used only by integration/e2e tests. The database is wiped before each run.
TEST_DATABASE_URL=postgres://postgres:change-me@localhost:5432/erp_test

# --- JWT -------------------------------------------------------------------
JWT_ISSUER=erp-backend
JWT_AUDIENCE=erp-clients
# Comma-separated kid:secret pairs (secret >= 32 chars). First key signs; all keys verify.
# Rotate by prepending a new key, then removing the old one after JWT_ACCESS_TOKEN_TTL.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SIGNING_KEYS=k1:replace-with-a-random-secret-of-at-least-32-chars
# Seconds
JWT_ACCESS_TOKEN_TTL=900
JWT_REFRESH_TOKEN_TTL=2592000

# --- HTTP ------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173
COOKIE_SECURE=true
SWAGGER_ENABLED=true

# --- Authentication policy -------------------------------------------------
REGISTRATION_ENABLED=true
EMAIL_VERIFICATION_REQUIRED=true
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900
PASSWORD_RESET_TOKEN_TTL=1800
EMAIL_VERIFICATION_TOKEN_TTL=86400
PERMISSION_CACHE_TTL=30

# --- Rate limiting (per client IP, per window) ------------------------------
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_LIMIT=120
AUTH_RATE_LIMIT_LIMIT=10

# --- Mail ------------------------------------------------------------------
# Front-end base URL used to build links in emails (tokens go in the URL fragment).
APP_PUBLIC_URL=http://localhost:5173
MAIL_FROM="ERP <no-reply@example.com>"
# smtp | file (writes .eml files to MAIL_FILE_DIR; non-production only) | memory (tests)
MAIL_TRANSPORT=file
SMTP_URL=smtp://localhost:1025
MAIL_FILE_DIR=./var/mail
OUTBOX_POLL_INTERVAL_MS=2000

# --- Administrator bootstrap (npm run admin:bootstrap) ----------------------
# Read once by the bootstrap script; remove from the environment afterwards.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_DISPLAY_NAME=Administrator
